<?xml version="1.0"?>
<package format="3">
  <name>audition_nav2</name>
  <version>0.1.0</version>
  <description>Optional, fail-closed acoustic advisory Nav2 costmap plugin.</description>
  <maintainer email="maintainer@example.invalid">audition_ros2 maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>audition_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/acoustic_layer_plugin.xml"/>
  </export>
</package>
