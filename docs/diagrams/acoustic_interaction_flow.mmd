flowchart TB
  MIC["ReSpeaker / ALSA / WAV"] --> CAP["audio_capture<br/>device / capture time / channel map"]
  CAP -->|"AudioFrame: raw PCM"| SP["spatial_perception<br/>ODAS / acoustic identity"]
  SP -->|"SourceAudioFrame: mono per source"| SEM["semantic_perception<br/>classification, VAD, ASR, temporal events"]
  SP -->|"AcousticSourceArray"| SC["acoustic_scene<br/>canonical states and TTL"]
  SEM -->|"SoundClassification / AcousticEvent / Transcript"| SC
  SC -->|"AcousticScene / events / transcripts"| CONS["ROS consumers / UI"]
  SC --> ATT["attention_manager<br/>look / listen / investigate"]
  SC --> FUS["multimodal_fusion<br/>tf2, audio-visual and radar association"]
  TF["tf2 / odom / IMU"] --> FUS
  CAM["OAK-D / visual tracks"] --> FUS
  RAD["Radar, optional"] --> FUS
  FUS -->|"LocalizedSourceArray: metric + covariance"| COST["Nav2 AcousticCostmapLayer plugin"]
  FUS --> ATT
  SC --> MEM["acoustic_memory<br/>history and room observations"]
  FUS --> MEM
  ATT -->|"Safe Nav2 actions"| NAV["Nav2 + independent motion safety"]
  COST --> NAV
  NAV -. "Movement enables new measurements" .-> MIC
