# Read-only, namespaced semantic admission and generation diagnostics.
---
bool have_stream
uint64 source_generation
string frame_id
uint32 admitted_sources
uint64 accepted_audio_frames
uint64 dropped_audio_frames
# Subset of dropped_audio_frames: duplicate/reordered sequence or backwards capture time.
uint64 out_of_order_audio_frames
uint64 rejected_source_snapshots
uint64 stream_resets

# Local semantic-worker restart, NOT the upstream spatial source generation.
uint64 reload_epoch
uint64 reload_successes
uint64 reload_failures
bool reload_pending

# Last accepted canonical /sources sequence (0 before first admission).
uint64 last_source_sequence

# Current canonical acoustic_scene incarnation and accepted restarts.
string scene_session_id
uint64 scene_session_resets

# M2u: completed inference telemetry, not PCM admission or model accuracy.
# Ages are zero before first completion; silence can legitimately yield no results.
bool classifier_active
bool speech_active
uint64 classifier_completed_windows
uint64 classifier_discarded_results
uint64 classifier_last_completion_age_ms
uint64 asr_completed_segments
uint64 asr_empty_segments
uint64 asr_discarded_results
uint64 asr_last_completion_age_ms
uint64 inference_poll_failures

# M2v: sampled native worker workload; not per-job deadlines or watchdog health.
# Classifier states count currently active sources, NOT individual queued jobs.
uint32 classifier_active_sources
uint32 classifier_waiting_sources
uint32 classifier_collecting_sources
uint32 classifier_queued_sources
uint32 classifier_inferencing_sources
uint32 classifier_classified_sources
uint32 classifier_error_sources
uint64 classifier_dropped_windows_active
bool classifier_has_inference_timing
float64 classifier_max_last_inference_ms
bool classifier_has_queue_wait_timing
float64 classifier_max_last_queue_wait_ms
# ASR queue excludes the currently running job; result mailbox is separate.
uint64 asr_queued_segments
uint64 asr_buffered_results
uint64 asr_retired_generations
uint64 asr_completed_segments_native
uint64 asr_dropped_segments_native
uint64 asr_evicted_results_native
bool asr_worker_error
